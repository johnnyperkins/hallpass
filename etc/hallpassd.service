[Unit]
Description=Hallpass interactive application firewall daemon
Documentation=https://github.com/hallpass/hallpass
After=network-pre.target
Wants=network-pre.target
# Never stop retrying. The default start limit gives up after 5 attempts in
# 10s, which with queue_bypass = false leaves the table standing with no
# daemon to answer its queue, dropping every new connection indefinitely.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/hallpassd --config /etc/hallpass/config.toml
Restart=on-failure
RestartSec=2

# Runtime directory for the two client sockets. The daemon re-applies this
# mode and sets the group to hallpass. 0751 rather than 0750 because two
# sockets with two groups live here and a directory carries one: a member of
# hallpass-observer and not of hallpass has to traverse this to reach the
# read-only socket. The x for others is traversal of a known path, not
# listing, and each socket's own 0660 plus its group still decides who may
# connect.
RuntimeDirectory=hallpass
RuntimeDirectoryMode=0751

# /var/lib/hallpass, for the first-seen state (which applications, and which
# destinations for them, this host has already seen). systemd creates it and
# adds it to ReadWritePaths, which ProtectSystem=strict otherwise denies.
# 0700: the file inside is a record of what this host talks to, and only the
# daemon reads it. Without this the daemon warns once and keeps the state in
# memory, which costs the annotation across a restart and nothing else.
StateDirectory=hallpass
StateDirectoryMode=0700

# Hardening
ProtectSystem=strict
ReadWritePaths=/etc/hallpass /run/hallpass
ProtectHome=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
PrivateTmp=yes
UMask=0077
SystemCallArchitectures=native
# No device nodes beyond the pseudo devices. The daemon runs as uid 0, so
# without this ProtectSystem is only a view: /dev/sda underneath it opens
# read-write on file permissions alone. DevicePolicy rather than
# PrivateDevices, which would replace /dev and with it the /dev/log symlink
# the local syslog target writes through; the device controller refuses the
# open and leaves the path alone.
DevicePolicy=closed
# Descriptors are what attribution opens /proc with for every connection,
# and IPC connections take one each; running out turns every /proc read
# into a silent miss. The IPC sockets cap their own connections, and this
# leaves room well past that.
LimitNOFILE=16384

# Everything root would otherwise carry, dropped to what the daemon uses:
#   NET_ADMIN        install the nftables table, bind the NFQUEUE netlink socket
#   DAC_READ_SEARCH  read files regardless of mode bits: hashing another
#                    user's 0700 binary for an exe_sha256 rule
#   SYS_PTRACE       pass the kernel's ptrace access check, which gates the
#                    /proc/<pid>/exe and /proc/<pid>/fd readlinks for other
#                    users' processes. DAC_READ_SEARCH does not satisfy that
#                    check (probed live: readlink /proc/<pid>/exe under a
#                    bounding set with only DAC_READ_SEARCH fails, and
#                    succeeds the moment SYS_PTRACE is added). Without it,
#                    attribution silently loses the executable path for any
#                    process the eBPF exec snapshot has not covered: anything
#                    started before the daemon, and every process on a
#                    procfs-only build. The visible symptom is prompt answers
#                    that apply their verdict but cannot create a rule
#                    ("prompt reply for connection without executable path").
#                    It also opens /proc/1/root, the host's view that every
#                    executable path is checked against.
#                    Not only visibility, though: the ptrace syscall is in
#                    @debug and stays outside SystemCallFilter below, but
#                    the same access check also lets a compromised daemon
#                    write another process's memory through /proc/<pid>/mem,
#                    which no syscall filter can refuse. process_vm_writev
#                    and process_vm_readv, which @system-service does
#                    include, are refused below.
#   CHOWN            chgrp the IPC socket and its directory to the hallpass group
#   BPF, PERFMON     load the eBPF programs, attach kprobes and uprobes
#   SYS_RESOURCE     raise RLIMIT_MEMLOCK for BPF maps (kernels before 5.11)
# Deliberately absent: SYS_ADMIN, which costs two things, both annotation
# rather than enforcement. On kernels before 5.8, bpf() needs it rather than
# CAP_BPF, so eBPF attribution there falls back to procfs and says so in the
# journal ("eBPF attribution unavailable, using procfs fallback"). And on
# several kernel lines the uprobe perf PMU demands SYS_ADMIN where the kprobe
# PMU accepts PERFMON (probe-confirmed live: same binary, kprobes attach,
# "libc DNS snoop unavailable: ... perf_event_open failed"; adding SYS_ADMIN
# via drop-in, "libc DNS snoop active"), so under this unit the libc-resolver
# DNS snoop is degraded: the wire snooper still covers plaintext port 53, and
# what goes missing is names resolved through a stub resolver or an encrypted
# upstream. Granting SYS_ADMIN is close to granting root, so both losses are
# accepted here rather than defaulted away; opt in per host with a drop-in
# (systemctl edit hallpassd) appending SYS_ADMIN:
#   [Service]
#   CapabilityBoundingSet=
#   CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_CHOWN CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_SYS_ADMIN
# NET_RAW is absent too: NFQUEUE is netlink, not a raw socket, and a wrong
# guess there fails loudly at "nfqueue bind failed".
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_CHOWN CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE

# An allow-list, deliberately with no group-level "~" deny line. Mixing the
# two forms subtracts the deny set from the allow set, and perf_event_open
# belongs to @debug, so a "~@debug" line would revoke the perf_event_open
# granted here and break uprobe-based DNS snooping. @system-service already excludes @clock,
# @module, @obsolete, @raw-io, @reboot and @swap, so such a line bought almost
# nothing while risking exactly that. bpf and perf_event_open are both outside
# @system-service and so must be named explicitly.
SystemCallFilter=@system-service bpf perf_event_open
# Subtracted from the set above, which is what a "~" line does here and is
# wanted: see SYS_PTRACE above. Nothing in the daemon calls either.
SystemCallFilter=~process_vm_readv process_vm_writev

# ProtectProc is deliberately NOT set: attribution reads /proc/<pid>/exe and
# /proc/<pid>/fd for processes owned by other users, which invisible or
# ptraceable would hide, silently degrading every exe-scoped rule.
#
# To confirm the two restrictions above on a host, after starting the unit
# check that the journal shows no SIGSYS and no "Operation not permitted", that
# `hallpass-cli status` works as a hallpass-group member (which proves CAP_CHOWN
# applied), and, with the ebpf feature built in, that the journal says "eBPF
# attribution active" rather than the procfs-fallback warning.

[Install]
WantedBy=multi-user.target

[Unit]
Description=Sentinel interactive application firewall daemon
Documentation=https://github.com/sentinel/sentinel
After=network-pre.target
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/sentineld --config /etc/sentinel/config.toml
Restart=on-failure
RestartSec=2

# Runtime directory for the client socket.
RuntimeDirectory=sentinel
RuntimeDirectoryMode=0755

# Hardening
ProtectSystem=strict
ReadWritePaths=/etc/sentinel /run/sentinel
ProtectHome=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

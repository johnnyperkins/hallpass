root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

# install.sh and uninstall.sh are tab-indented; keep them that way.
[*.sh]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

# Two trailing spaces are a hard line break in Markdown, so trimming them
# would silently reflow prose.
[*.md]
trim_trailing_whitespace = false
